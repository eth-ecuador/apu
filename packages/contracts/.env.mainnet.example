# 0G Mainnet Configuration
# Copy this file to .env.mainnet and fill in your values

# ============================================
# 0G MAINNET SETTINGS
# ============================================

# 0G Mainnet RPC URL (DO NOT CHANGE unless using custom RPC)
OG_RPC_URL=https://evmrpc.0g.ai

# Your private key for deployment (KEEP SECRET!)
# IMPORTANT: This account must have 0G tokens for gas fees
# Recommended: At least 0.01 0G for deployment
OG_DEPLOYER_PRIVATE_KEY=your_mainnet_private_key_here

# Optional: 0G Explorer API Key (for contract verification)
OG_EXPLORER_API_KEY=

# ============================================
# TESTNET SETTINGS (KEEP FOR BACKUP)
# ============================================

# Ethereum Sepolia (for testing)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=your_sepolia_key_here
ETHERSCAN_API_KEY=your_etherscan_key_here

# 0G Galileo Testnet
OG_GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai
OG_GALILEO_DEPLOYER_PRIVATE_KEY=your_testnet_key_here

# ============================================
# NETWORK REFERENCE
# ============================================

# 0G Mainnet
# Chain ID: 16661
# RPC: https://evmrpc.0g.ai
# Explorer: https://scan.0g.ai
# Symbol: 0G

# 0G Galileo Testnet
# Chain ID: 16602
# RPC: https://evmrpc-testnet.0g.ai
# Explorer: https://scan-testnet.0g.ai
# Symbol: 0G (testnet)

# ============================================
# SECURITY NOTES
# ============================================

# 1. NEVER commit this file with real values
# 2. Add .env.mainnet to .gitignore
# 3. Store private keys securely (hardware wallet recommended)
# 4. Use separate keys for testnet and mainnet
# 5. Verify you're deploying to correct network before running scripts
