# Hardhat Variables (set via: npx hardhat vars set VARIABLE_NAME)
# Or use .env file with hardhat-dotenv plugin

# Deployment Account
MNEMONIC=your twelve word mnemonic phrase here for deployment account

# Infura API Key (for Sepolia RPC)
INFURA_API_KEY=your_infura_api_key_here

# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Example values (DO NOT USE IN PRODUCTION):
# MNEMONIC="hello ankle thrive concert humor rug general quit remove scare sweet evoke"
# INFURA_API_KEY="80ea6890511241c3bb77bf5bc6c75270"
# ETHERSCAN_API_KEY="NHXUVKYPHEITT9IX2AUPMKTKN4SJFMBUAU"

# To set variables:
# npx hardhat vars set MNEMONIC
# npx hardhat vars set INFURA_API_KEY
# npx hardhat vars set ETHERSCAN_API_KEY
