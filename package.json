{
  "name": "apu-medical-ai",
  "version": "1.0.0",
  "private": true,
  "description": "APU - AI-powered medical diagnosis with FHE privacy and decentralized AI",
  "author": "APU Team",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace=app",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "contracts:compile": "npm run compile --workspace=packages/contracts",
    "contracts:deploy:sepolia": "npm run deploy:sepolia --workspace=packages/contracts",
    "contracts:deploy:og": "npm run deploy:og --workspace=packages/contracts",
    "backend:dev": "npm run dev --workspace=packages/backend",
    "db:push": "npm run db:push --workspace=packages/backend",
    "db:studio": "npm run db:studio --workspace=packages/backend"
  },
  "dependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "^0.9.0",
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.10",
    "@fhevm/solidity": "^0.11.1",
    "@openzeppelin/confidential-contracts": "^0.5.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@privy-io/react-auth": "^3.35.2",
    "@privy-io/server-auth": "^1.32.5",
    "@stripe/stripe-js": "^9.13.0",
    "@tanstack/react-query": "^5.62.0",
    "@zama-fhe/react-sdk": "^3.3.0",
    "@zama-fhe/sdk": "^3.3.0",
    "drizzle-orm": "^0.45.2",
    "ethers": "6.13.1",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "viem": "^2.55.0",
    "wagmi": "^2.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "^0.4.2",
    "@fhevm/mock-utils": "^0.4.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@tailwindcss/postcss": "^4",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/node": "^20.19.30",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@zama-fhe/relayer-sdk": "^0.4.1",
    "drizzle-kit": "^0.31.10",
